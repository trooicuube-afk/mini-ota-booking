#!/bin/sh
# Maven Wrapper script
# https://maven.apache.org/wrapper/

set -e

# Find project base directory
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Download Maven if not cached
MAVEN_HOME="$HOME/.m2/wrapper/dists"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
    MAVEN_DIST_URL=$(grep "distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2- | tr -d '\r')
fi

if [ -z "$MAVEN_DIST_URL" ]; then
    MAVEN_DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip"
fi

MAVEN_DIST_NAME=$(basename "$MAVEN_DIST_URL" .zip)
MAVEN_INSTALL_DIR="$MAVEN_HOME/$MAVEN_DIST_NAME"

if [ ! -d "$MAVEN_INSTALL_DIR" ]; then
    echo "Downloading Maven from $MAVEN_DIST_URL..."
    mkdir -p "$MAVEN_INSTALL_DIR"
    TMP_FILE=$(mktemp)
    curl -sL "$MAVEN_DIST_URL" -o "$TMP_FILE"
    unzip -q "$TMP_FILE" -d "$MAVEN_INSTALL_DIR"
    rm -f "$TMP_FILE"
fi

MAVEN_CMD="$MAVEN_INSTALL_DIR/$MAVEN_DIST_NAME/bin/mvn"

if [ ! -f "$MAVEN_CMD" ]; then
    # Try to find mvn in extracted dir
    MAVEN_CMD=$(find "$MAVEN_INSTALL_DIR" -name "mvn" -type f | head -1)
fi

if [ ! -f "$MAVEN_CMD" ]; then
    echo "Error: Could not find Maven executable"
    exit 1
fi

exec "$MAVEN_CMD" \
    -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
    "$@"
